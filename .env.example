# Copy this file to .env and fill in your values. Never commit .env to git.

# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-this
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — use sqlite:/// for local dev, postgres:// for production
# SQLite (default for local dev):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL example:
# DATABASE_URL=postgres://user:password@localhost:5432/drainsense

# Strands model provider: bedrock (default) or ollama
AGENT_MODEL_PROVIDER=bedrock

# Optional AWS credentials — required only when using Amazon Bedrock.
# Prefer configuring credentials through your local AWS credential provider.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Optional local Ollama provider (no AWS credentials required)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL_ID=llama3.2:3b

# Open-Meteo (free, no key needed)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# ML model path
MODEL_ARTIFACT_PATH=ml/artifacts/risk_model.pkl
