# Copy this file to .env and fill in your values. Never commit .env to git.

# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-this
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — use sqlite:/// for local dev, postgres:// for production
# SQLite (default for local dev):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL example:
# DATABASE_URL=postgres://user:password@localhost:5432/drainsense

# AWS — for Strands Agents SDK (uses Bedrock)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1

# Open-Meteo (free, no key needed)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# ML model path
MODEL_ARTIFACT_PATH=ml/artifacts/risk_model.pkl
